#!/bin/sh
# Conventional Commits check. https://www.conventionalcommits.org/en/v1.0.0/
# Installed into .git/hooks/commit-msg by .agents/setup.
# ponytail: first-line regex only; add body/footer rules if the team needs them.

# First non-comment, non-blank line = the header.
header=$(grep -vE '^(#|\s*$)' "$1" | head -n1)

# Merge/revert/fixup commits are exempt.
case "$header" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if printf '%s' "$header" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF

✗ Commit message is not Conventional Commits compliant.

  Got:      $header
  Expected: <type>[(scope)][!]: <description>
  Types:    feat fix docs style refactor perf test build ci chore revert

  Examples:
    feat: add favorites carousel
    fix(reader): guard null story id
    chore!: drop Flutter 3.16 support

  See https://www.conventionalcommits.org/en/v1.0.0/
EOF
exit 1
